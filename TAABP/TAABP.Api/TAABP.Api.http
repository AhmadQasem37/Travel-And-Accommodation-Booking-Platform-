@baseUrl = https://localhost:7169
@token = //{{login.response.body.token}}
@adminToken = {{adminLogin.response.body.token}}

### ========================================
### AUTH ENDPOINTS (API v1)
### ========================================

### Register a new user
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "newuser",
  "email": "newuser@gmail.com",
  "password": "NewUser@123",
  "firstName": "New",
  "lastName": "User",
  "phoneNumber": "+971501234567"
}

### Login (User) - Seeded user: user@gmail.com / user123
### Response includes: token, expiresAt, role (User/Admin)
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "user123"
}

### Login (Admin) - Seeded admin: admin@gmail.com / admin
### Response includes: token, expiresAt, role (User/Admin)
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "password": "admin"
}

### ========================================
### PROTECTED ENDPOINTS (require token)
### ========================================

### Example: User endpoint (requires User token)
# GET {{baseUrl}}/api/v1/users/me
# Authorization: Bearer {{token}}

### Example: Admin endpoint (requires Admin token)
# GET {{baseUrl}}/api/v1/admin/dashboard
# Authorization: Bearer {{adminToken}}

### ========================================
### HOTELS ENDPOINTS (API v1)
### ========================================

### Get hotel details by ID - User only
### Records visit to recently visited hotels for authenticated users
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666
Authorization: Bearer {{token}}

### Get hotel details - Hotel not found (404)
GET {{baseUrl}}/api/v1/hotels/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{token}}

### Get available rooms for a hotel - default pagination (page 1, pageSize 10)
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/rooms
Authorization: Bearer {{token}}

### Get available rooms - with pagination
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/rooms?page=1&pageSize=5
Authorization: Bearer {{token}}

### Get available rooms - with admin token
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/rooms?page=1&pageSize=10
Authorization: Bearer {{adminToken}}

### Get available rooms - Hotel not found (404)
GET {{baseUrl}}/api/v1/hotels/00000000-0000-0000-0000-000000000001/rooms
Authorization: Bearer {{token}}

### Get hotel reviews - default pagination (page 1, pageSize 10)
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews
Authorization: Bearer {{token}}

### Get hotel reviews - with pagination
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews?page=1&pageSize=5
Authorization: Bearer {{token}}

### Get hotel reviews - page 2
GET {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews?page=2&pageSize=10
Authorization: Bearer {{token}}

### Get hotel reviews - Hotel not found (404)
GET {{baseUrl}}/api/v1/hotels/00000000-0000-0000-0000-000000000001/reviews
Authorization: Bearer {{token}}

### Get featured deals - default (top 5 hotels with discounts) - User only
GET {{baseUrl}}/api/v1/hotels/featured-deals
Authorization: Bearer {{token}}

### Get featured deals - custom count (top 3) - User only
GET {{baseUrl}}/api/v1/hotels/featured-deals?count=3
Authorization: Bearer {{token}}

### Get featured deals - max count (top 10) - User only
GET {{baseUrl}}/api/v1/hotels/featured-deals?count=10
Authorization: Bearer {{token}}

### Get recently visited hotels - default (last 5) - User only
GET {{baseUrl}}/api/v1/hotels/recently-visited
Authorization: Bearer {{token}}

### Get recently visited hotels - custom count - User only
GET {{baseUrl}}/api/v1/hotels/recently-visited?count=3
Authorization: Bearer {{token}}

### Search hotels - default (today/tomorrow, 2 adults, sorted by price)
GET {{baseUrl}}/api/v1/hotels/search
Authorization: Bearer {{adminToken}}

### Search hotels - with query filter
GET {{baseUrl}}/api/v1/hotels/search?searchQuery=Dubai
Authorization: Bearer {{adminToken}}

### Search hotels - with date range and guests
GET {{baseUrl}}/api/v1/hotels/search?checkInDate=2025-12-10&checkOutDate=2025-12-15&adults=2&children=1&rooms=1
Authorization: Bearer {{adminToken}}

### Search hotels - with price range
GET {{baseUrl}}/api/v1/hotels/search?minPrice=100&maxPrice=500
Authorization: Bearer {{adminToken}}

### Search hotels - with star ratings (4 and 5 stars)
GET {{baseUrl}}/api/v1/hotels/search?starRatings=4&starRatings=5
Authorization: Bearer {{token}}

### Search hotels - sorted by star rating descending
GET {{baseUrl}}/api/v1/hotels/search?sortBy=StarRating&sortOrder=Desc
Authorization: Bearer {{token}}

### Search hotels - with pagination
GET {{baseUrl}}/api/v1/hotels/search?page=1&pageSize=5
Authorization: Bearer {{token}}

### Search hotels - full example with all filters
GET {{baseUrl}}/api/v1/hotels/search?searchQuery=hotel&checkInDate=2025-12-10&checkOutDate=2025-12-15&adults=2&children=0&rooms=1&minPrice=50&maxPrice=1000&starRatings=4&starRatings=5&sortBy=Price&sortOrder=Asc&page=1&pageSize=10
Authorization: Bearer {{token}}

### ========================================
### CITIES ENDPOINTS (API v1)
### ========================================

### Get trending destinations - default (top 5 most visited cities) - User only
GET {{baseUrl}}/api/v1/cities/trending-destinations
Authorization: Bearer {{token}}

### Get trending destinations - custom count (top 3) - User only
GET {{baseUrl}}/api/v1/cities/trending-destinations?count=3
Authorization: Bearer {{token}}

### Get trending destinations - max count (top 10) - User only
GET {{baseUrl}}/api/v1/cities/trending-destinations?count=10
Authorization: Bearer {{token}}

### ========================================
### AMENITIES ENDPOINTS (API v1)
### ========================================

### Get all amenities - for filter dropdowns - User only
GET {{baseUrl}}/api/v1/amenities
Authorization: Bearer {{token}}

### ========================================
### ROOM TYPES ENDPOINTS (API v1)
### ========================================

### Get all room types - for filter dropdowns - User only
GET {{baseUrl}}/api/v1/room-types
Authorization: Bearer {{token}}

### ========================================
### REVIEWS ENDPOINTS (API v1)
### ========================================

### Create review - valid review
POST {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 5,
  "content": "We had a wonderful time at this hotel. The room was clean and spacious, and the staff was incredibly helpful."
}

### Create review - minimum valid content
POST {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 3,
  "content": "Average stay overall."
}

### Create review - Hotel not found (404)
POST {{baseUrl}}/api/v1/hotels/00000000-0000-0000-0000-000000000001/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 4,
  "content": "This hotel does not exist, should return 404."
}

### Create review - Invalid rating (400)
POST {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 6,
  "content": "Invalid rating - should fail validation."
}

### Create review - Content too short (400)
POST {{baseUrl}}/api/v1/hotels/66666666-6666-6666-6666-666666666666/reviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 4,
  "content": "Too short"
}
