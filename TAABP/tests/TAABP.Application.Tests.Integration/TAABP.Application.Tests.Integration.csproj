<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TAABP.Application.Tests.Integration</AssemblyName>
    <RootNamespace>TAABP.Application.Tests.Integration</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.2" />
    <PackageReference Include="Moq" Version="4.20.69" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../TAABP.Api/TAABP.Api.csproj" />
    <ProjectReference Include="../../TAABP.Application/TAABP.Application.csproj" />
    <ProjectReference Include="../../TAABP.Domain/TAABP.Domain.csproj" />
    <ProjectReference Include="../../TAABP.Infrastructure/TAABP.Infrastructure.csproj" />
  </ItemGroup>

</Project>
